          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('E2E retrieve returns 200', () => pm.expect(pm.response.code).to.eql(200));",
                  "if (pm.response.code === 200) pm.expect(pm.response.json().name).to.eql(pm.variables.get('e2e_label_name'));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Update",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "PRIVATE-TOKEN",
                "value": "{{token_label_manager}}"
              },
