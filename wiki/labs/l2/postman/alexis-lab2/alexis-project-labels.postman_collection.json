                "type": "text/javascript",
                "exec": [
                  "pm.test('E2E update returns 200', () => pm.expect(pm.response.code).to.eql(200));",
                  "if (pm.response.code === 200) pm.expect(pm.response.json().name).to.eql(pm.variables.get('e2e_label_name_updated'));"
