              }
            ],
            "url": "{{base_url}}/projects/{{project_id}}/labels/{{e2e_label_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('E2E delete returns 204', () => pm.expect(pm.response.code).to.eql(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Confirm deletion",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "PRIVATE-TOKEN",
                "value": "{{token_label_manager}}"
              }
            ],
            "url": "{{base_url}}/projects/{{project_id}}/labels/{{e2e_label_name_updated_url}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('E2E deleted label returns 404', () => pm.expect(pm.response.code).to.eql(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cleanup - Delete archived label if present",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "PRIVATE-TOKEN",
            "value": "{{token_label_manager}}"
          }
        ],
        "url": "{{base_url}}/projects/{{project_id}}/labels/{{archived_label_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Cleanup returns 204 or resource is already absent', () => pm.expect([204, 404]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    }
  ]
}
