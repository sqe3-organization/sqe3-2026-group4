{
  "info": {
    "name": "SQE3 Lab 2 - Group 4 - Alexis Frene - Project Labels",
    "description": "Lab 2 individual Postman collection for the GitLab Project labels REST API v4. The collection contains no credentials.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "let runId = pm.collectionVariables.get('run_id');",
          "if (!runId) {",
          "  runId = String(Date.now());",
          "  pm.collectionVariables.set('run_id', runId);",
          "}",
          "const values = {",
          "  label_name: `sqe3-label-${runId}`,",
          "  label_name_updated: `sqe3-label-updated-${runId}`,",
          "  control_label_name: `sqe3-control-${runId}`,",
          "  e2e_label_name: `sqe3-e2e-label-${runId}`,",
          "  e2e_label_name_updated: `sqe3-e2e-updated-${runId}`",
          "};",
          "Object.entries(values).forEach(([key, value]) => pm.collectionVariables.set(key, value));",
          "pm.collectionVariables.set('label_name_url', encodeURIComponent(values.label_name));",
          "pm.collectionVariables.set('label_name_updated_url', encodeURIComponent(values.label_name_updated));",
          "pm.collectionVariables.set('control_label_name_url', encodeURIComponent(values.control_label_name));",
          "pm.collectionVariables.set('e2e_label_name_url', encodeURIComponent(values.e2e_label_name));",
          "pm.collectionVariables.set('e2e_label_name_updated_url', encodeURIComponent(values.e2e_label_name_updated));"
        ]
      }
    }
  ],
