    {
      "name": "TC_ISSUE_E2E_001 - Complete issue lifecycle",
      "description": "End-to-end lifecycle flow: create issue -> read details -> update description and close -> filter closed issues -> delete issue -> verify deletion with 404.",
      "item": [
        {
          "name": "E2E Step 1 - Create issue",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "PRIVATE-TOKEN",
                "value": "{{token_reporter}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
