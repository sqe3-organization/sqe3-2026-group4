        "description": "Verifies that an existing issue can be retrieved by its project-scoped internal ID (iid) with status 200 OK."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "});",
              "pm.test(\"Retrieved issue matches expected iid and has complete attributes\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(String(jsonData.iid)).to.eql(pm.variables.get(\"issue_iid\"));",
              "    pm.expect(jsonData.state).to.be.oneOf([\"opened\", \"closed\"]);",
              "    pm.expect(jsonData).to.have.property(\"author\");",
              "    pm.expect(jsonData).to.have.property(\"created_at\");",
              "});",
              "pm.test(\"Response time is below 2500ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2500);",
              "});"
            ]
          }
        }
      ]
    },
