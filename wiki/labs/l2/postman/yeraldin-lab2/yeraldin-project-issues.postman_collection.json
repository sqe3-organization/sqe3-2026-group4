  "item": [
    {
      "name": "TC_ISSUE_POST_001 - Create an issue with valid data",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "PRIVATE-TOKEN",
            "value": "{{token_reporter}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{issue_title}}\",\n  \"description\": \"Defect report: unexpected status code in API call\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/projects/{{project_id}}/issues",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "projects",
            "{{project_id}}",
            "issues"
          ]
        },
        "description": "Verifies that creating an issue with a valid title and description returns 201 Created and state opened."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.expect(pm.response.code).to.eql(201);",
              "});",
              "pm.test(\"Response contains valid issue data and opened state\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"iid\");",
              "    pm.expect(jsonData).to.have.property(\"id\");",
              "    pm.expect(jsonData.state).to.eql(\"opened\");",
              "    pm.expect(jsonData.title).to.eql(pm.variables.get(\"issue_title\"));",
              "    pm.expect(jsonData.description).to.eql(\"Defect report: unexpected status code in API call\");",
              "    pm.collectionVariables.set(\"issue_iid\", String(jsonData.iid));",
              "    pm.collectionVariables.set(\"issue_id\", String(jsonData.id));",
              "});",
              "pm.test(\"Content-Type header is JSON\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});"
            ]
          }
        }
      ]
    },
