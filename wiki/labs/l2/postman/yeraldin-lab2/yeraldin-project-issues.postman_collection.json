{
  "info": {
    "name": "SQE3 Lab 2 - Group 4 - Yeraldin Vasquez - Project Issues",
    "description": "Lab 2 individual Postman collection for the GitLab Project issues REST API v4. Implements functional, boundary, negative, authorization, and E2E lifecycle tests with comprehensive assertions and zero committed credentials.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "let runId = pm.collectionVariables.get(\"run_id\");",
          "if (!runId) {",
          "  runId = String(Date.now());",
          "  pm.collectionVariables.set(\"run_id\", runId);",
          "}",
          "const values = {",
          "  issue_title: `sqe3-issue-${runId}`,",
          "  issue_title_updated: `sqe3-issue-updated-${runId}`,",
          "  e2e_issue_title: `sqe3-e2e-issue-${runId}`,",
          "  labels_issue_title: `sqe3-labels-issue-${runId}`",
          "};",
          "Object.entries(values).forEach(([key, val]) => pm.collectionVariables.set(key, val));"
        ]
      }
    }
  ],
