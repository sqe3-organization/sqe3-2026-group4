    {
      "name": "GET / auth me",
      "description": "",
      "item": [
        {
          "name": "TC-FAKE-009 Get current user with bearer token returns the user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{FAKE_BASE_URL}}/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{FAKE_ACCESS_TOKEN}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Username matches the login', () => pm.expect(pm.response.json().username).to.eql(pm.environment.get('FAKE_USER')));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-FAKE-010 Get current user with an invalid token returns 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{FAKE_BASE_URL}}/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
