  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const limit = Number(pm.environment.get('RESPONSE_TIME_LIMIT_MS') || 500);",
          "const elapsed = Math.round(pm.response.responseTime);",
          "",
          "pm.test('Content-Type should be present', function () {",
          "    pm.response.to.have.header('Content-Type');",
          "});",
          "",
          "if (elapsed <= limit) {",
          "    pm.test(`Response time should be less than ${limit}ms`, function () {});",
          "} else {",
          "    // slow responses are only noted, they don't fail the test",
          "    pm.test.skip(`Response time was ${elapsed} ms (target ${limit} ms)`, function () {});",
          "}"
        ]
      }
    }
  ]
