    {
      "name": "POST / auth login",
      "description": "",
      "item": [
        {
          "name": "TC-FAKE-008 Login with valid credentials returns a token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{FAKE_BASE_URL}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{FAKE_USER}}\",\n  \"password\": \"{{FAKE_PASSWORD}}\",\n  \"expiresInMins\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('accessToken is returned', () => pm.expect(body.accessToken).to.be.a('string').and.not.empty);",
                  "pm.environment.set('FAKE_ACCESS_TOKEN', body.accessToken);"
                ]
              }
            }
          ]
        }
