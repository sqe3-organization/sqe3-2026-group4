  "item": [
    {
      "name": "GET / products",
      "description": "",
      "item": [
        {
          "name": "TC-FAKE-001 List products returns the requested page",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{FAKE_BASE_URL}}/products?limit=5&select=title,price"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Body has 5 products and pagination fields', () => {",
                  "    pm.expect(body.products).to.be.an('array').with.lengthOf(5);",
                  "    pm.expect(body.limit).to.eql(5);",
                  "    pm.expect(body.total).to.be.above(0);",
                  "});",
                  "pm.test('Every product has id, title and price', () => {",
                  "    body.products.forEach(p => pm.expect(p).to.include.keys('id', 'title', 'price'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-FAKE-002 Get product by id returns that product",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{FAKE_BASE_URL}}/products/1"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returned id is 1', () => pm.expect(body.id).to.eql(1));",
                  "pm.test('Price is a positive number', () => pm.expect(body.price).to.be.a('number').and.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-FAKE-003 Get product that does not exist returns 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{FAKE_BASE_URL}}/products/99999"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Message names the missing id', () => pm.expect(pm.response.json().message).to.include('99999'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "POST / products",
      "description": "POST and then a GET to check the data.",
      "item": [
        {
          "name": "TC-FAKE-004 Add product returns the new product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{FAKE_BASE_URL}}/products/add",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{PRODUCT_TITLE}}\",\n  \"price\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Title matches what was sent', () => pm.expect(body.title).to.eql(pm.environment.get('PRODUCT_TITLE')));",
                  "pm.test('A new id is generated', () => pm.expect(body.id).to.be.a('number'));",
                  "pm.environment.set('NEW_PRODUCT_ID', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-FAKE-005 Data integrity GET after POST shows the fake API does not persist",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{FAKE_BASE_URL}}/products/{{NEW_PRODUCT_ID}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// dummyjson does not really save it",
                  "pm.test('Status code is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
