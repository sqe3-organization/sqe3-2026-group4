              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Blob metadata and content valid', () => {",
                  "    const blob = pm.response.json();",
                  "    pm.expect(blob.sha).to.equal(pm.variables.get('readme_blob_sha'));",
                  "    pm.expect(blob.encoding).to.equal('base64');",
                  "    pm.expect(blob.size).to.equal(194);",
                  "    pm.expect(Buffer.from(blob.content, 'base64').toString('utf8')).to.include('# Laboratorio Semana 1');",
                  "});"
