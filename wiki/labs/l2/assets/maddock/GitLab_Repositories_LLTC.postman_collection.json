        {
          "id": "5a112d4a-7a19-4f93-89b7-070efabaa86e",
          "name": "TC_REPO_E2E_001 - Browse and read the same immutable file",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Step 1: Root tree returns 200', () => pm.response.to.have.status(200));",
                  "const baseUrl = pm.variables.get('base_url');",
                  "const projectId = pm.variables.get('project_id');",
                  "const ref = pm.variables.get('ref');",
                  "const headers = { Accept: 'application/json' };",
                  "const token = pm.variables.get('token_editor');",
                  "if (token) headers['PRIVATE-TOKEN'] = token;",
                  "",
                  "pm.sendRequest({ url: `${baseUrl}/projects/${projectId}/repository/tree?ref=${encodeURIComponent(ref)}&recursive=true`, header: headers }, (err, res) => {",
                  "    pm.test('Step 2: Recursive tree returns 200', () => pm.expect(res.code).to.equal(200));",
                  "    const tree = res.json();",
                  "    const readme = tree.find(e => e.path === 'README.md');",
                  "    pm.test('Step 2: Discovers README blob SHA', () => pm.expect(readme).to.not.be.undefined);",
                  "    const sha = readme.id;",
                  "",
                  "    pm.sendRequest({ url: `${baseUrl}/projects/${projectId}/repository/blobs/${sha}`, header: headers }, (err, jsonRes) => {",
                  "        pm.test('Step 3: Blob JSON returns 200', () => pm.expect(jsonRes.code).to.equal(200));",
                  "        const blob = jsonRes.json();",
                  "        pm.test('Step 3: SHA and size match', () => {",
                  "            pm.expect(blob.sha).to.equal(sha);",
                  "            pm.expect(blob.size).to.equal(194);",
                  "        });",
                  "",
                  "        pm.sendRequest({ url: `${baseUrl}/projects/${projectId}/repository/blobs/${sha}/raw`, header: headers }, (err, rawRes) => {",
                  "            pm.test('Step 4: Raw blob matches decoded JSON', () => {",
                  "                pm.expect(rawRes.code).to.equal(200);",
                  "                pm.expect(rawRes.text()).to.equal(Buffer.from(blob.content, 'base64').toString('utf8'));",
                  "            });",
                  "        });",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/repository/tree?ref={{ref}}&recursive=false",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects",
                "{{project_id}}",
                "repository",
                "tree"
              ],
              "query": [
                {
                  "key": "ref",
                  "value": "{{ref}}"
                },
                {
                  "key": "recursive",
                  "value": "false"
                }
              ]
            }
          }
        }
      ]
    }
