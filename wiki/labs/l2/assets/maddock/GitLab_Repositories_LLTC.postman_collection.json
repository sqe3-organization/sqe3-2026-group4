      "item": [
        {
          "id": "1d5079a5-3030-4d47-b196-3accd98f88dc",
          "name": "TC_REPO_GET_001 - List root entries at a pinned revision",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type is JSON', () => pm.response.to.be.json);",
                  "pm.test('Root entries contain README blob and docs tree', () => {",
                  "    const tree = pm.response.json();",
                  "    pm.expect(tree).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(tree.some(e => e.name === 'README.md' && e.type === 'blob')).to.be.true;",
                  "    pm.expect(tree.some(e => e.name === 'docs' && e.type === 'tree')).to.be.true;",
                  "    pm.expect(tree.some(e => e.path.includes('/'))).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/repository/tree?ref={{ref}}&recursive=false",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects",
                "{{project_id}}",
                "repository",
                "tree"
              ],
              "query": [
                {
                  "key": "ref",
                  "value": "{{ref}}"
                },
                {
                  "key": "recursive",
                  "value": "false"
                }
              ]
            }
          }
        },
        {
          "id": "a6d40746-ced0-420e-b283-2fbc1abadcd2",
          "name": "TC_REPO_GET_002 - List all nested entries recursively",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Recursive tree contains nested files and README SHA', () => {",
                  "    const tree = pm.response.json();",
                  "    pm.expect(tree.some(e => e.path === 'docs/activity-1.md')).to.be.true;",
                  "    pm.expect(tree.some(e => e.path.startsWith('docs/images/'))).to.be.true;",
                  "    const readme = tree.find(e => e.path === 'README.md');",
                  "    pm.expect(readme.id).to.equal(pm.variables.get('readme_blob_sha'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/repository/tree?ref={{ref}}&recursive=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects",
                "{{project_id}}",
                "repository",
                "tree"
              ],
              "query": [
                {
                  "key": "ref",
                  "value": "{{ref}}"
                },
                {
                  "key": "recursive",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "id": "af073f62-75d1-46d7-bf31-5808c8dbc869",
          "name": "TC_REPO_GET_003 - Restrict listing to a directory",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Only docs directory items returned', () => {",
                  "    const tree = pm.response.json();",
                  "    pm.expect(tree).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(tree.every(e => e.path.startsWith('docs/'))).to.be.true;",
                  "    pm.expect(tree.some(e => e.path.startsWith('docs/images/'))).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
