      "item": [
        {
          "id": "1a30fb92-91f9-4c5d-a772-730b91118e4f",
          "name": "TC_DEMO_POST_001 - Create an object",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const obj = pm.response.json();",
                  "pm.test('Object created with ID', () => {",
                  "    pm.expect(obj.id).to.be.a('string');",
                  "    pm.collectionVariables.set('sample_object_id', obj.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Apple MacBook Pro 16\",\"data\":{\"year\":2026,\"price\":1849.99,\"CPU_model\":\"Intel Core i9\"}}"
            },
            "url": {
