              ],
              "path": [
                "projects",
                "{{project_id}}",
                "repository",
                "tree"
              ],
              "query": [
                {
                  "key": "ref",
                  "value": "{{ref}}"
                },
                {
                  "key": "path",
                  "value": "docs"
                },
                {
                  "key": "recursive",
                  "value": "false"
                }
              ]
            }
          }
        },
        {
          "id": "f9888de3-f0d9-4c04-afe4-6e926fc5fc01",
          "name": "TC_REPO_GET_004 - Resolve an encoded nested path",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Only direct children of docs/images returned', () => {",
                  "    const tree = pm.response.json();",
                  "    pm.expect(tree).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(tree.every(e => /^docs\\/images\\/[^\\/]+$/.test(e.path))).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
