{
  "name": "gitlab-api-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run tests/unit --coverage",
    "test:performance:multimedia": "bun run scripts/run-multimedia-performance.ts",
    "test:reports": "bun run scripts/generate-test-reports.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "logs:pretty": "pino-pretty --colorize --translateTime SYS:standard",
    "typecheck": "bun check --no-script",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "got": "16.2.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "oxlint": "1.93.0",
    "pino-pretty": "13.2.0",
    "vitest": "5.1.0"
  }
}
